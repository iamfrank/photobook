// Generated by photobook. Edit captions, reorder photo(...) calls, or move
// calls between book-page(...) groups to put more photos on particular pages.
// Each group sizes its rows automatically. Then compile this reviewed file.
// Keep this source alongside its .assets folder when moving/sharing it.
#set page(paper: "a5", margin: 12mm, numbering: none)
#set text(size: 9pt)
#set par(spacing: 0pt)

#let photo(path, caption: "") = layout(size => {
  let description = block(width: size.width, align(center, text(caption)))
  let caption-space = if caption == "" { 0pt } else { measure(description).height + 3mm }
  let room = size.height - caption-space
  assert(room >= 10mm, message: "Caption too long to leave room for photo: " + path)
  let natural = measure(image(path, width: size.width))
  let photo-width = size.width * calc.min(1, room / natural.height)
  let cells = (align(center, image(path, width: photo-width, fit: "contain")),)
  if caption != "" { cells.push(description) }
  block(width: size.width, height: size.height, breakable: false,
    align(center + horizon, grid(columns: (1fr,), row-gutter: 3mm, ..cells)))
})

// Layout is local to each page: one equal-height row per photo.
#let book-page(..photos) = {
  let photos = photos.pos()
  block(width: 100%, height: 100%, breakable: false,
    grid(columns: (1fr,), rows: (1fr,) * photos.len(), row-gutter: 5mm,
      ..photos))
}

